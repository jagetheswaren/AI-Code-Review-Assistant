# AI Code Review Assistant - Environment Variables
# Copy this file to .env and fill in your values

# Flask Configuration
FLASK_ENV=development
FLASK_PORT=5000

# CORS
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# GitHub Integration
GITHUB_TOKEN=your_github_personal_access_token
GITHUB_WEBHOOK_SECRET=your_webhook_secret

# Ollama Configuration
OLLAMA_MODEL=qwen2.5-coder:3b
OLLAMA_BASE_URL=http://localhost:11434

# JWT Secret (generate with: python -c "import secrets; print(secrets.token_urlsafe(48))")
JWT_SECRET=development-only-change-me

# MongoDB Atlas Connection String
MONGO_URI=mongodb+srv://username:password@cluster.mongodb.net/code_review_assistant

# Optional GitHub OAuth fields. OAuth routes are not enabled in this release;
# keep these server-side only if you add that integration.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_OAUTH_CALLBACK_URL=

LOG_LEVEL=INFO
