# AI Code Review Assistant - Environment Variables
# Copy this file to .env and fill in your values

# Flask Configuration
FLASK_ENV=development
FLASK_PORT=5000

# CORS
CORS_ORIGINS=http://localhost:3000/,http://localhost:5173/

# GitHub Integration
GITHUB_TOKEN=your_github_personal_access_token
GITHUB_WEBHOOK_SECRET=your_webhook_secret
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_CALLBACK_URL=http://localhost:5000/api/github/oauth/callback
GITHUB_OAUTH_CALLBACK_URL=http://localhost:5000/api/github/oauth/callback

# Frontend API config (React app)
REACT_APP_API_URL=http://localhost:5000/api

# Ollama Configuration
OLLAMA_MODEL=qwen2.5-coder:7b
OLLAMA_BASE_URL=http://127.0.0.1:11434
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# JWT Secret (generate with: python -c "import secrets; print(secrets.token_urlsafe(48))")
JWT_SECRET=development-only-change-me

# MongoDB Connection String
MONGO_URI=mongodb://localhost:27017/code_review_assistant

LOG_LEVEL=INFO
