# Production Environment Variables

# Flask
FLASK_ENV=production
FLASK_PORT=5000

# CORS (must use HTTPS URLs!)
CORS_ORIGINS=https://your-frontend.vercel.app

# GitHub
GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxx
GITHUB_WEBHOOK_SECRET=your-webhook-secret-here

# GitHub OAuth
GITHUB_CLIENT_ID=your-github-client-id
GITHUB_CLIENT_SECRET=your-github-client-secret
GITHUB_OAUTH_CALLBACK_URL=https://your-backend.onrender.com/api/github/oauth/callback

# Frontend URL
FRONTEND_URL=https://your-frontend.vercel.app

# JWT (use a strong, unique secret!)
JWT_SECRET=your-super-strong-production-jwt-secret

# MongoDB Atlas
MONGO_URI=mongodb+srv://username:password@cluster.mongodb.net/code_review_assistant?retryWrites=true&w=majority

# Ollama — REQUIRED for AI review. Local dev uses http://127.0.0.1:11434
# Production on Render CANNOT reach localhost — set a reachable URL (e.g., hosted Ollama, OpenAI proxy)
# If left empty, AI will be marked BLOCKED: "AI review unavailable; static analysis completed."
OLLAMA_BASE_URL=https://your-ollama-host.example.com
OLLAMA_MODEL=qwen2.5-coder:7b

# ML
ML_MODEL_PATH=backend/ml/models/severity_classifier_v3.joblib
NLP_MODEL_NAME=microsoft/codebert-base

# Frontend
REACT_APP_API_URL=https://your-backend.onrender.com/api
