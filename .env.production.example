# Production Environment Variables
# Use these on Render (backend) and Vercel (frontend)

# ==================== BACKEND (Render) ====================
# Flask
FLASK_ENV=production
FLASK_PORT=5000

# CORS - Update with your Vercel URL
CORS_ORIGINS=https://your-app.vercel.app

# GitHub (generate at https://github.com/settings/tokens)
GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxx
GITHUB_WEBHOOK_SECRET=generate-with-openssl-rand-hex-32

# Optional GitHub OAuth (server-side only; OAuth routes are not included yet)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_OAUTH_CALLBACK_URL=https://your-backend.onrender.com/api/auth/github/callback

# JWT (generate with: python -c "import secrets; print(secrets.token_hex(32))")
JWT_SECRET=your-64-char-hex-secret-here

# MongoDB Atlas (get from MongoDB Atlas > Connect > Drivers)
MONGO_URI=mongodb+srv://username:password@cluster.mongodb.net/code_review_assistant?retryWrites=true&w=majority

# Ollama (use external Ollama or deploy separately)
OLLAMA_MODEL=qwen2.5-coder:3b
OLLAMA_BASE_URL=https://your-ollama-instance.com
LOG_LEVEL=INFO

# ==================== FRONTEND (Vercel) ====================
# Add these in Vercel Project Settings > Environment Variables
REACT_APP_API_URL=https://your-backend.onrender.com/api

# ==================== GITHUB WEBHOOK ====================
# In GitHub repo: Settings > Webhooks > Add webhook
# Payload URL: https://your-backend.onrender.com/api/webhook/github
# Content type: application/json
# Secret: GITHUB_WEBHOOK_SECRET (same as above)
# Events: Pull requests
