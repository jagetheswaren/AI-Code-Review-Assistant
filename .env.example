# Flask Backend Variables
FLASK_ENV=development
MONGO_URI=mongodb://localhost:27017/code_review_assistant
JWT_SECRET=your_jwt_secret_here
CORS_ORIGINS=http://localhost:3000
LOG_LEVEL=INFO

# AI & ML — core feature: Ollama + qwen2.5-coder:7b
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5-coder:7b

# GitHub OAuth Integration
GITHUB_CLIENT_ID=your_github_client_id
GITHUB_CLIENT_SECRET=your_github_client_secret
GITHUB_OAUTH_CALLBACK_URL=http://localhost:5000/api/github/oauth/callback
GITHUB_WEBHOOK_SECRET=your_webhook_secret

# React Frontend Variables
REACT_APP_API_URL=http://localhost:5000/api