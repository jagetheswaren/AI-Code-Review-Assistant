# Development Environment Variables
# Copy to .env and fill in your values

# Flask
FLASK_ENV=development
FLASK_PORT=5000

# CORS
CORS_ORIGINS=http://localhost:3000,http://localhost:80

# GitHub (get from GitHub Settings > Developer settings > Personal access tokens)
GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxx
GITHUB_WEBHOOK_SECRET=your-webhook-secret-here

# JWT (use strong secret in production!)
JWT_SECRET=dev-super-secret-jwt-key-change-in-production

# MongoDB (local docker-compose)
MONGO_URI=mongodb://mongodb:27017/code_review_assistant

# Ollama (local docker-compose)
OLLAMA_MODEL=qwen2.5-coder:3b
OLLAMA_BASE_URL=http://ollama:11434

# Frontend
REACT_APP_API_URL=http://localhost:5000/api