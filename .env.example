# ==========================================
# IntelliReview AI Environment Configuration
# ==========================================

# -----------------
# 1. CORE BACKEND
# -----------------
# FLASK_ENV: "development" for local running, "production" for deployed app
FLASK_ENV=development
# CORS_ORIGINS: Comma-separated list of allowed frontend domains. In prod, set to your Vercel URL.
CORS_ORIGINS=http://localhost:3000
LOG_LEVEL=INFO

# -----------------
# 2. DATABASE & AUTH
# -----------------
# MONGO_URI: Localhost for dev. Replace with MongoDB Atlas URI for production.
MONGO_URI=mongodb://localhost:27017/code_review_assistant
# JWT_SECRET: MUST be changed to a secure random string in production!
JWT_SECRET=your_super_secret_jwt_key_change_in_production

# -----------------
# 3. AI / LLM
# -----------------
# For Local AI: Install Ollama and run `ollama run qwen2.5-coder:7b`
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5-coder:7b
# For Cloud AI: Get a free key at https://console.groq.com/keys
# GROQ_API_KEY=your_groq_api_key_here

# -----------------
# 4. GITHUB INTEGRATION
# -----------------
# Set these up in GitHub Developer Settings -> OAuth Apps
GITHUB_CLIENT_ID=your_github_client_id
GITHUB_CLIENT_SECRET=your_github_client_secret
# Must match your backend URL in production
GITHUB_OAUTH_CALLBACK_URL=http://localhost:5000/api/github/oauth/callback
# Used to secure webhooks sent from GitHub to your backend
GITHUB_WEBHOOK_SECRET=your_secure_webhook_secret

# -----------------
# 5. FRONTEND (React)
# -----------------
# Set this in your Vercel/Netlify dashboard for the frontend build
REACT_APP_API_URL=http://localhost:5000/api